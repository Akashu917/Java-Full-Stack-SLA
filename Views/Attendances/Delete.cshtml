@model Attendance

@{
    ViewData["Title"] = "Delete Attendance";
}

<h1>Delete Attendance Record</h1>
<div class="alert alert-warning">Are you sure you want to delete this record?</div>

<div class="card p-4 mb-3" style="max-width:600px;">
    <dl class="row mb-0">
        <dt class="col-sm-4">Employee</dt>
        <dd class="col-sm-8">@Model.Employee?.Name (@Model.Employee?.Department)</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Date)</dt>
        <dd class="col-sm-8">@Model.Date.ToString("dd-MMM-yyyy")</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.CheckInTime)</dt>
        <dd class="col-sm-8">@Model.CheckInTime.ToString(@"hh\:mm")</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.CheckOutTime)</dt>
        <dd class="col-sm-8">@(Model.CheckOutTime.HasValue ? Model.CheckOutTime.Value.ToString(@"hh\:mm") : "-")</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="AttendanceId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
