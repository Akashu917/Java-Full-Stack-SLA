@model Attendance

@{
    ViewData["Title"] = "Attendance Details";
}

<h1>Attendance Details</h1>

<div class="card p-4" style="max-width:600px;">
    <dl class="row mb-0">
        <dt class="col-sm-4">Employee</dt>
        <dd class="col-sm-8">@Model.Employee?.Name (@Model.Employee?.Department)</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Date)</dt>
        <dd class="col-sm-8">@Model.Date.ToString("dd-MMM-yyyy")</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.CheckInTime)</dt>
        <dd class="col-sm-8">@Model.CheckInTime.ToString(@"hh\:mm")</dd>

        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.CheckOutTime)</dt>
        <dd class="col-sm-8">@(Model.CheckOutTime.HasValue ? Model.CheckOutTime.Value.ToString(@"hh\:mm") : "Not checked out yet")</dd>
    </dl>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.AttendanceId" class="btn btn-outline-secondary">Edit</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>
