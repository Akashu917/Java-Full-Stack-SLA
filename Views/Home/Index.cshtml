@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="mb-4">Employee Attendance Management System</h1>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card p-3 text-center">
            <div class="text-muted">Total Employees</div>
            <div class="dashboard-stat">@ViewBag.EmployeeCount</div>
            <a asp-controller="Employees" asp-action="Index" class="stretched-link"></a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 text-center">
            <div class="text-muted">Total Attendance Records</div>
            <div class="dashboard-stat">@ViewBag.AttendanceCount</div>
            <a asp-controller="Attendances" asp-action="Index" class="stretched-link"></a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 text-center">
            <div class="text-muted">Checked In Today</div>
            <div class="dashboard-stat">@ViewBag.TodayCount</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card p-4">
            <h5>Manage Employees</h5>
            <p class="text-muted">Add, view, edit, or remove employee records (Name, Email, Department).</p>
            <a asp-controller="Employees" asp-action="Index" class="btn btn-primary">Go to Employees</a>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card p-4">
            <h5>Manage Attendance</h5>
            <p class="text-muted">Log daily check-in / check-out times against an employee.</p>
            <a asp-controller="Attendances" asp-action="Index" class="btn btn-primary">Go to Attendance</a>
        </div>
    </div>
</div>
