@model Employee

@{
    ViewData["Title"] = "Employee Details";
}

<h1>Employee Details</h1>

<div class="card p-4 mb-4" style="max-width:600px;">
    <dl class="row mb-0">
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Name)</dt>
        <dd class="col-sm-9">@Model.Name</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Email)</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Department)</dt>
        <dd class="col-sm-9">@Model.Department</dd>
    </dl>
</div>

<h4>Attendance History</h4>
<div class="card">
    <table class="table table-striped mb-0">
        <thead>
            <tr>
                <th>Date</th>
                <th>Check-in</th>
                <th>Check-out</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Attendances != null && Model.Attendances.Any())
        {
            @foreach (var a in Model.Attendances.OrderByDescending(a => a.Date))
            {
                <tr>
                    <td>@a.Date.ToString("dd-MMM-yyyy")</td>
                    <td>@a.CheckInTime.ToString(@"hh\:mm")</td>
                    <td>@(a.CheckOutTime.HasValue ? a.CheckOutTime.Value.ToString(@"hh\:mm") : "-")</td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="3" class="text-center text-muted py-3">No attendance records yet.</td></tr>
        }
        </tbody>
    </table>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.EmployeeId" class="btn btn-outline-secondary">Edit</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>
